# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# JWT_SECRET: signing key for session tokens. REQUIRED in production —
# the server refuses to start without it when NODE_ENV=production.
# Generate one with: openssl rand -hex 32
# If unset in development, a random secret is generated per run, which means
# every restart logs everyone out.
JWT_SECRET="replace_with_a_long_random_string"

# ADMIN_INITIAL_PASSWORD: password for the `admin` account, used ONCE when the
# database is first created. If unset, a strong random password is generated
# and printed to the console at first startup — save it then.
# Must be at least 10 characters. Change it from the Settings page afterwards.
ADMIN_INITIAL_PASSWORD=""

# HOST / PORT: network interface to listen on. Defaults to 127.0.0.1 (this
# machine only), which is the safe choice.
# Set HOST=0.0.0.0 ONLY behind a reverse proxy that terminates HTTPS —
# this app speaks plain HTTP, so on an open network anyone can read the
# passwords and session tokens of every till.
HOST="127.0.0.1"
PORT="3000"

# NODE_ENV: set to "production" for a real deployment. This enforces the
# JWT_SECRET requirement, enables HSTS, tightens the Content-Security-Policy,
# and serves the built `dist/` bundle instead of running Vite in dev mode.
NODE_ENV="development"

# SEED_DEMO_DATA: set to "true" only to populate sample items and customers
# for a demo. Leave unset for a real shop so you start with a clean catalogue.
SEED_DEMO_DATA=""

# DB_PATH: where the SQLite database lives. Defaults to ./pos.db next to the
# application. Point this at a directory that your backups actually cover —
# keeping the shop's books inside the app folder means a redeploy or a careless
# `rm -rf` takes the ledger with it. The directory is created if missing.
# Example: DB_PATH="/var/lib/vyapara/pos.db"
DB_PATH=""

# AUDIT_LOG_RETENTION_DAYS: how long the activity log is kept before old rows
# are pruned (default 400). GST records live in the bills tables, not here, so
# this does not affect tax history.
AUDIT_LOG_RETENTION_DAYS="400"

# LOW_STOCK_THRESHOLD: stock at or below this appears in the dashboard's low
# stock panel (default 10).
LOW_STOCK_THRESHOLD="10"
