# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# JWT_SECRET: signing key for session tokens. REQUIRED in production —
# the server refuses to start without it when NODE_ENV=production.
# Generate one with: openssl rand -hex 32
# If unset in development, a random secret is generated per run, which means
# every restart logs everyone out.
JWT_SECRET="replace_with_a_long_random_string"

# ADMIN_INITIAL_PASSWORD: password for the `admin` account, used ONCE when the
# database is first created. If unset, a strong random password is generated
# and printed to the console at first startup — save it then.
# Must be at least 10 characters. Change it from the Settings page afterwards.
ADMIN_INITIAL_PASSWORD=""

# HOST / PORT: network interface to listen on. Defaults to 127.0.0.1 (this
# machine only), which is the safe choice.
# Set HOST=0.0.0.0 ONLY behind a reverse proxy that terminates HTTPS —
# this app speaks plain HTTP, so on an open network anyone can read the
# passwords and session tokens of every till.
HOST="127.0.0.1"
PORT="3000"

# NODE_ENV: set to "production" for a real deployment. This enforces the
# JWT_SECRET requirement, enables HSTS, tightens the Content-Security-Policy,
# and serves the built `dist/` bundle instead of running Vite in dev mode.
NODE_ENV="development"

# SEED_DEMO_DATA: set to "true" only to populate sample items and customers
# for a demo. Leave unset for a real shop so you start with a clean catalogue.
SEED_DEMO_DATA=""

# DB_PATH: where the SQLite database lives. Defaults to ./pos.db next to the
# application. Point this at a directory that your backups actually cover —
# keeping the shop's books inside the app folder means a redeploy or a careless
# `rm -rf` takes the ledger with it. The directory is created if missing.
# Example: DB_PATH="/var/lib/vyapara/pos.db"
DB_PATH=""

# AUDIT_LOG_RETENTION_DAYS: how long the activity log is kept before old rows
# are pruned (default 400). GST records live in the bills tables, not here, so
# this does not affect tax history.
AUDIT_LOG_RETENTION_DAYS="400"

# LOW_STOCK_THRESHOLD: stock at or below this appears in the dashboard's low
# stock panel (default 10).
LOW_STOCK_THRESHOLD="10"

# --- Backups -----------------------------------------------------------------
# BACKUP_DIR: where backups are written (default: backups/ in the app folder).
# AUTO_BACKUP_HOURS: take an automatic backup this often while the app runs
#   (default 24; 0 turns automatic backups off).
# BACKUP_KEEP_DAYS: delete automatic backups older than this (default 30).
#   Backups made with the Backup Now button are never deleted.
# BACKUP_COPY_DIR: also copy every backup here — a USB drive, or a Google
#   Drive / OneDrive folder — so a failed laptop disk does not lose the books.
#   Only finished backup files are copied; never point DB_PATH at a synced
#   folder, as a sync client can corrupt a live database.
# Example: BACKUP_COPY_DIR="D:\VyaparaBackups"
BACKUP_DIR=""
AUTO_BACKUP_HOURS="24"
BACKUP_KEEP_DAYS="30"
BACKUP_COPY_DIR=""

# --- Google Drive backup ------------------------------------------------------
# Every backup is also uploaded to the owner's Google Drive once connected in
# Settings → Google Drive Backup. One-time setup in Google Cloud: see the README
# section "Google Drive backup". The app only gets access to files it creates.
# PUBLIC_URL: the address the app is reached at (no trailing slash). Google
#   sends the browser back to PUBLIC_URL/api/backups/google/callback.
PUBLIC_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Kannada names (Settings -> Language). The server asks Google Translate for
# each new item's Kannada name in the background, and Google Input Tools to
# write each customer's and bakery's name in Kannada letters. Only these names
# are sent: never phone numbers, addresses, GSTINs, prices or bills.
# With GOOGLE_TRANSLATE_API_KEY set, items use the paid Cloud Translation API;
# without it, Google's free web endpoint. TRANSLATE_ITEM_NAMES="off" never
# contacts Google. TRANSLATE_CUSTOMER_NAMES="off" keeps customers' names on
# this computer (they then show in English) while items are still translated.
# GOOGLE_TRANSLATE_API_KEY=""
# TRANSLATE_ITEM_NAMES="off"
# TRANSLATE_CUSTOMER_NAMES="off"

# Admin accounts can sign in only on this computer (localhost); from the
# website or phone app through the tunnel, only cashiers can. "on" allows
# admin from anywhere, e.g. for remote support. Restart after changing it.
# ALLOW_REMOTE_ADMIN="on"

# REMOTE_ADMIN_USERNAME / REMOTE_ADMIN_PASSWORD: one admin account that CAN
# sign in from the internet (the website or phone app through the tunnel),
# e.g. for the owner away from the shop. Created on start; the other admins
# stay at this computer only. The password must be at least 12 characters —
# use a long random one, as anyone who has it can run the shop's books. It is
# managed only here: the app cannot change, deactivate or delete it. Change the
# password here and restart to replace it (open sessions are signed out);
# remove both lines and restart to turn the account off.
# REMOTE_ADMIN_NAME is the name shown in the app (default "Owner (remote)").
# START_FRESH / START_FRESH_CONFIRM: erase the practice data after a trial
# period and start the shop for real. On the next start of the app:
#   START_FRESH="transactions"  erases bills, purchases, payments, customer
#                               credit, stock and the activity log; keeps the
#                               items (stock 0, selling price kept), customers
#                               and suppliers
#   START_FRESH="everything"    also erases the items, customers and suppliers
# Staff logins and shop settings are always kept, a full backup is saved to the
# backups folder first, and bill numbers start again at 0001. It runs only
# with START_FRESH_CONFIRM set to a word of at least 4 characters, and only
# once for each word, so leaving the lines here afterwards does nothing.
# START_FRESH="transactions"
# START_FRESH_CONFIRM="ERASE-TRIAL-1"

# REMOTE_ADMIN_USERNAME="owner"
# REMOTE_ADMIN_PASSWORD=""
# REMOTE_ADMIN_NAME="Owner (remote)"
