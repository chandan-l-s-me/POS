# node_modules is a link to node_modules.nosync, which iCloud Drive does not
# sync or offload (offloaded files made the build time out).
node_modules
node_modules.nosync/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Local SQLite database & generated backups — contain real customer data,
# hashed passwords, and GSTINs. Never commit these.
*.db
*.db-journal
# WAL mode (enabled in db/index.ts) writes these alongside the database;
# the -wal file holds recently committed transactions, so it leaks the same
# customer data the .db does.
*.db-wal
*.db-shm
/backups/
